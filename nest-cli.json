{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "tsc",
    "assets": [
      {
        "include": "base_modules/email/templates/**/*",
        "outDir": "dist"
      }
    ],
    "deleteOutDir": true
  }
}