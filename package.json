{
  "name": "api",
  "version": "0.0.48-alpha",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest build && ENV=prod node ./dist/utils/validate-env.js && ENV=prod nest start",
    "start:dev": "nest build && ENV=dev node ./dist/utils/validate-env.js && ENV=dev nest start --watch",
    "start:staging": "nest build && ENV=staging node ./dist/utils/validate-env.js && ENV=staging nest start",
    "start:test": "nest build && ENV=test node ./dist/utils/validate-env.js && ENV=test nest start --watch",
    "start:debug": "nest build && ENV=dev node ./dist/utils/validate-env.js && ENV=dev nest start --debug 0.0.0.0:9229 --watch",
    "start:prod": "nest build && ENV=prod node dist/scripts/run-migrations.js && ENV=prod node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "type-check": "tsc --noEmit",
    "check": "pnpm lint && pnpm type-check && pnpm format && pnpm test && pnpm test:e2e test/integration/*contract*.e2e-spec.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migration:generate:codeclarity": "typeorm-ts-node-commonjs migration:generate src/migrations/codeclarity/Init -d src/datasources/codeclarity.datasource.ts",
    "migration:generate:knowledge": "typeorm-ts-node-commonjs migration:generate src/migrations/knowledge/Init -d src/datasources/knowledge.datasource.ts",
    "migration:generate:plugins": "typeorm-ts-node-commonjs migration:generate src/migrations/plugins/Init -d src/datasources/plugins.datasource.ts",
    "migration:run:codeclarity": "ts-node -r tsconfig-paths/register src/scripts/run-migration-cli.ts codeclarity",
    "migration:run:knowledge": "ts-node -r tsconfig-paths/register src/scripts/run-migration-cli.ts knowledge",
    "migration:run:plugins": "ts-node -r tsconfig-paths/register src/scripts/run-migration-cli.ts plugins",
    "migration:run:config": "ts-node -r tsconfig-paths/register src/scripts/run-migration-cli.ts config",
    "migration:revert:codeclarity": "typeorm-ts-node-commonjs migration:revert -d src/datasources/codeclarity.datasource.ts",
    "migration:revert:knowledge": "typeorm-ts-node-commonjs migration:revert -d src/datasources/knowledge.datasource.ts",
    "migration:revert:plugins": "typeorm-ts-node-commonjs migration:revert -d src/datasources/plugins.datasource.ts",
    "migration:revert:config": "typeorm-ts-node-commonjs migration:revert -d src/datasources/config.datasource.ts"
  },
  "dependencies": {
    "@css-inline/css-inline": "0.21.2",
    "@fastify/compress": "9.2.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/static": "10.1.3",
    "@nestjs-modules/mailer": "2.3.7",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "11.2.3",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-fastify": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/typeorm": "12.0.1",
    "@prometheus-io/client": "0.16.1",
    "@webundsoehne/nest-fastify-file-upload": "2.3.1",
    "amqplib": "2.0.1",
    "axios": "1.20.0",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "fastify": "5.12.3",
    "handlebars": "4.7.9",
    "jsonwebtoken": "9.0.3",
    "lodash": "4.18.1",
    "ms": "2.1.3",
    "nodemailer": "8.0.11",
    "octokit": "5.0.5",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "semver": "7.8.5",
    "socket.io": "4.8.3",
    "tslib": "2.8.1",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.3",
    "@octokit/types": "18.0.0",
    "@swc/core": "1.16.2",
    "@swc/jest": "0.2.39",
    "@types/amqplib": "0.10.8",
    "@types/bcrypt": "6.0.0",
    "@types/eslint-plugin-security": "3.0.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/ms": "2.1.0",
    "@types/node": "26.5.0",
    "@types/nodemailer": "8.0.1",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.23.1",
    "@types/semver": "7.8.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.12.0",
    "jest": "30.5.1",
    "jest-util": "30.5.1",
    "prettier": "3.9.6",
    "source-map-support": "0.5.21",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "@swc/jest",
        {
          "jsc": {
            "parser": {
              "syntax": "typescript",
              "decorators": true
            },
            "transform": {
              "legacyDecorator": true,
              "decoratorMetadata": true
            },
            "target": "es2021",
            "assumptions": {
              "setPublicClassFields": true
            }
          },
          "module": {
            "type": "commonjs"
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!**/*.e2e-spec.ts",
      "!**/node_modules/**",
      "!**/dist/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/../test/utils/jest-setup.ts"
    ],
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "transformIgnorePatterns": [
      "^(?!.*@nestjs\\+(?:typeorm|config)).*/node_modules/"
    ]
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
