#!/bin/sh
# Lint, then run the tests affected by changes since origin/develop.
# Enable with: git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"
git fetch -q origin develop || echo "pre-push: could not fetch origin/develop, using the local copy"
node_modules/.bin/eslint "{src,apps,libs,test}/**/*.ts"
if ! node -e "require('@swc/core')" 2>/dev/null; then
  echo "pre-push: @swc/core does not load here (node_modules built for another OS), so Jest cannot run." >&2
  echo "pre-push: reinstall api/node_modules on this machine, or push with --no-verify." >&2
  exit 1
fi
node_modules/.bin/jest --changedSince=origin/develop
