pipeline {
    agent { label 'codeclarity' }

    options {
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Setup') {
            steps {
                script {
                    def project = readJSON file: 'package.json'
                    env.Version = project.version
                    env.Name = project.name
                    env.VersionTag = "v${Version}"
                    env.Tag = "codeclarityce/${Name}:${Version}"
                    echo "Version: ${Version}, Tag: ${Tag}"
                }
                sh 'git fetch --tags --force origin'
            }
        }

        stage('PR Version Check') {
            when {
                expression { env.CHANGE_TARGET == 'main' }
            }
            steps {
                script {
                    // No `|| true`: if main can't be fetched the check must fail,
                    // not compare against an empty version and pass.
                    sh 'git fetch --force origin main:refs/remotes/origin/main'
                    if (sh(script: 'git cat-file -e origin/main:package.json', returnStatus: true) != 0) {
                        echo 'No package.json on main yet, skipping version check'
                        return
                    }
                    def mainVersion = readJSON(text: sh(script: 'git show origin/main:package.json', returnStdout: true)).version
                    def highest = sh(
                        script: "printf '%s\\n%s\\n' '${mainVersion}' '${Version}' | sort -V | tail -n1",
                        returnStdout: true
                    ).trim()

                    echo "PR Version: ${Version}"
                    echo "Main Version: ${mainVersion}"

                    if (Version == mainVersion || highest != Version) {
                        error "Version not bumped! PR version (${Version}) must be greater than main version (${mainVersion}). Please update package.json version."
                    }
                    echo "Version check passed: ${mainVersion} -> ${Version}"
                }
            }
        }

        stage('Test') {
            // Run inside the Dockerfile's toolchain target (pinned Node, corepack
            // and the pnpm version from packageManager) instead of whatever the
            // agent host has installed. The container runs as the Jenkins uid, so
            // HOME and the pnpm store live in the workspace's @tmp sibling, which
            // Jenkins mounts but which stays out of the lint/format/docker context.
            agent {
                dockerfile {
                    filename '.cloud/docker/Dockerfile'
                    dir '.'
                    additionalBuildArgs '--target toolchain'
                    reuseNode true
                }
            }
            environment {
                HOME = "${env.WORKSPACE}@tmp/ci-home"
                CI = 'true'
            }
            steps {
                // Stage the standalone pnpm config (allowBuilds, minimumReleaseAge,
                // verifyDepsBeforeRun) at the repo root so pnpm finds it. Source of
                // truth lives under .cloud/docker/ so it's not picked up by the
                // parent monorepo when this submodule is consumed as part of
                // codeclarity-dev.
                sh 'cp .cloud/docker/pnpm-workspace.yaml pnpm-workspace.yaml'
                sh 'pnpm install --frozen-lockfile --store-dir "$WORKSPACE@tmp/pnpm-store"'
                sh 'pnpm lint:check'
                sh 'pnpm type-check'
                sh 'pnpm test'
                sh 'pnpm test:e2e test/integration/*contract*.e2e-spec.ts'
                sh 'pnpm exec prettier src --check'
            }
        }

        stage('Build') {
            when {
                not { branch 'main' }
            }
            steps {
                sh 'docker build -f .cloud/docker/Dockerfile --tag codeclarityce/api:latest --tag $Tag .'
            }
        }

        stage('Deploy') {
            when {
                branch 'main'
            }
            environment {
                // Bound only here so PR and branch builds never see the token.
                DOCKERHUB_CREDENTIALS = credentials('dockerhub')
            }
            steps {
                script {
                    // A released version is immutable: never overwrite its image
                    // (e.g. a direct push to main without a version bump).
                    if (sh(script: "git tag -l '${VersionTag}' | grep -q .", returnStatus: true) == 0) {
                        echo "Release ${VersionTag} already exists, skipping image push and release."
                        return
                    }

                    sh 'echo "$DOCKERHUB_CREDENTIALS_PSW" | docker login -u "$DOCKERHUB_CREDENTIALS_USR" --password-stdin'

                    // Reuse existing builder or create new one
                    sh 'docker buildx create --name api --use --bootstrap 2>/dev/null || docker buildx use api'

                    // Build and push first (can be retried without side effects)
                    sh 'docker buildx build -f .cloud/docker/Dockerfile --platform linux/amd64,linux/arm64 --tag codeclarityce/api:latest --tag $Tag --push .'

                    // Only create tag and release after successful push. --target
                    // pins the tag to the commit that was built, not main's tip.
                    sh """
                        gh release create '${VersionTag}' \
                            --target "\$GIT_COMMIT" \
                            --title 'Release ${VersionTag}' \
                            --generate-notes \
                            --prerelease=\$(echo '${Version}' | grep -q 'alpha\\|beta' && echo true || echo false)
                    """
                }
            }
        }
    }

    post {
        failure {
            echo "Build failed for ${env.Tag ?: 'unknown'}"
            sh 'docker buildx rm api || true'
        }
    }
}
